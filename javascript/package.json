{
  "name": "@crawlora-org/cricbuzz",
  "version": "0.1.0",
  "description": "Crawlora Cricbuzz API client with 29 endpoints for cricket matches, schedules, news, rankings, series, and records",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=cricbuzz-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-cricbuzz/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "cricbuzz", "cricbuzz-api", "cricbuzz-scraper", "cricbuzz-data", "cricbuzz-cricket-matches", "cricbuzz-schedules", "cricbuzz-news", "cricbuzz-rankings", "cricbuzz-series", "cricbuzz-records"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-cricbuzz",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
