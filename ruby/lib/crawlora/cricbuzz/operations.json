    "cricbuzz-archives": {
      "id": "cricbuzz-archives",
      "method": "GET",
      "path": "/cricbuzz/archives",
      "pathParams": [],
      "queryParams": [
        {
          "name": "year",
          "in": "query",
          "type": "integer"
        },
        {
          "name": "category",
          "in": "query",
          "type": "string",
          "enum": [
            "international",
            "league",
            "domestic",
            "women"
          ]
        },
        {
          "name": "q",
          "in": "query",
          "type": "string"
        }
      ],
      "bodyParam": null,
      "bodyRequired": false,
      "params": [
        {
          "description": "Archive year from the years array in the response",
          "in": "query",
          "name": "year",
          "type": "integer",
          "x-example": 2026
        },
        {
          "description": "Archive series category; omit for all categories",
          "enum": [
            "international",
            "league",
            "domestic",
            "women"
          ],
          "in": "query",
          "name": "category",
          "type": "string",
          "x-example": "international"
        },
        {
          "description": "Optional local case-insensitive substring search over selected-year series, up to 100 characters",
          "in": "query",
          "name": "q",
          "type": "string",
          "x-example": "india"
        }
      ],
      "produces": [
        "application/json"
      ],
      "security": [
        "ApiKeyAuth"
      ]
    },
